[Unit]
Description=Rust Scratch Card Web Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/scratch-card
ExecStart=/opt/scratch-card/scratch-card-server
Restart=always
RestartSec=3

Environment=RUST_LOG=info
Environment=SCRATCH_BIND=0.0.0.0:3000
Environment=SCRATCH_WEB_DIR=/opt/scratch-card/web
Environment=SCRATCH_CONFIG=/opt/scratch-card/config/game.json

[Install]
WantedBy=multi-user.target
